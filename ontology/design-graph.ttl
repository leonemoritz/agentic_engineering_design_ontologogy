dg:Need a owl:Class ;
    rdfs:label "Need"@en ;
    rdfs:subClassOf dg:Element .

dg:OptimizationSpec a owl:Class ;
    rdfs:label "OptimizationSpec"@en ;
    rdfs:comment "Variables, objectives and constraints of a sizing problem, so the search is declared, not implicit."@en ;
    rdfs:subClassOf dg:Element .

dg:ReviewFinding a owl:Class ;
    rdfs:label "ReviewFinding"@en .

dg:ValueRef a owl:Class ;
    rdfs:label "ValueRef"@en ;
    rdfs:comment "A number in the model: a part attribute (`attributes.<name>`), an evidence value (`value`), or a numeric field of any element (for example `agreement_ratio` on a Credibility record)."@en .

dg:Allowable a owl:Class ;
    rdfs:label "Allowable"@en ;
    rdfs:comment "A material value an analysis may use, with its basis, source and test status."@en ;
    rdfs:subClassOf dg:Element .

dg:Provenance a owl:Class ;
    rdfs:label "Provenance"@en ;
    rdfs:comment "Graph run that produced an analysis value."@en .

dg:Statistics a owl:Class ;
    rdfs:label "Statistics"@en .

dg:ToolDeclaration a owl:Class ;
    rdfs:label "ToolDeclaration"@en ;
    rdfs:comment "Toolchain preselected by the engineer; the framework records it, not assesses it."@en ;
    rdfs:subClassOf dg:Element .

dg:Assumption a owl:Class ;
    rdfs:label "Assumption"@en ;
    rdfs:subClassOf dg:Element .

dg:ConsistencyCheck a owl:Class ;
    rdfs:label "ConsistencyCheck"@en ;
    rdfs:comment "Two values from independent models that must agree within a relative tolerance. A violation becomes a rework item at `feedback_stage`."@en ;
    rdfs:subClassOf dg:Element .

dg:FailureMode a owl:Class ;
    rdfs:label "FailureMode"@en ;
    rdfs:comment "A way the design can fail, the requirements it threatens, and the analysis that covers it."@en ;
    rdfs:subClassOf dg:Element .

dg:trace a owl:ObjectProperty ;
    rdfs:label "trace"@en ;
    rdfs:comment "Source trace target; written for each active trace Relationship."@en .

dg:Part a owl:Class ;
    rdfs:label "Part"@en ;
    rdfs:subClassOf dg:Element .

dg:Review a owl:Class ;
    rdfs:label "Review"@en ;
    rdfs:comment "An independent review of elements, pinned to their content. Agents may review; a review is never an approval and never satisfies a requirement."@en ;
    rdfs:subClassOf dg:Element .

dg:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:comment "One result for one (case, requirement) pair. Pass/fail is computed, never stated."@en ;
    rdfs:subClassOf dg:Element .

dg:Quantity a owl:Class ;
    rdfs:label "Quantity"@en ;
    rdfs:comment "A magnitude with a unit string; empty unit means dimensionless."@en ;
    rdfs:subClassOf qudt:QuantityValue .

dg:TradeStudy a owl:Class ;
    rdfs:label "TradeStudy"@en ;
    rdfs:comment "Concepts screened against gates and criteria, with a decision that can be checked against the scores."@en ;
    rdfs:subClassOf dg:Element .

dg:Credibility a owl:Class ;
    rdfs:label "Credibility"@en ;
    rdfs:comment "How far a verification case's results can be trusted: tier, convergence, comparison, calibration."@en ;
    rdfs:subClassOf dg:Element .

dg:Principal a owl:Class ;
    rdfs:label "Principal"@en ;
    rdfs:comment "A person or agent. Only human principals may approve or attest."@en ;
    rdfs:subClassOf dg:Element .

dg:VerificationCase a owl:Class ;
    rdfs:label "VerificationCase"@en ;
    rdfs:subClassOf dg:Element .

dg:Entry a owl:Class ;
    rdfs:comment "One key of a mapping field."@en .

dg:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    rdfs:comment "A statement on a subject. `relation=None` makes it qualitative (attestation only)."@en ;
    rdfs:subClassOf dg:Element .

dg:Element a owl:Class ;
    rdfs:label "Element"@en ;
    rdfs:comment "Anything with a model-wide id."@en .

