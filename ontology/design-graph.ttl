dg:Criterion a owl:Class ;
    rdfs:label "Criterion"@en ;
    rdfs:comment "A gate (pass/fail) or a criterion (ranked) in a trade study, traced to what it comes from."@en .

dg:DesignVariable a owl:Class ;
    rdfs:label "DesignVariable"@en .

dg:Objective a owl:Class ;
