<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd">
  <THE-HEADER><REQ-IF-HEADER IDENTIFIER="SYN-HEADER"/></THE-HEADER>
  <CORE-CONTENT><SPECIFICATION-XML>
    <SPEC-TYPES><SPEC-OBJECT-TYPE IDENTIFIER="SYN-TYPE" LONG-NAME="Synthetic requirement">
      <SPEC-ATTRIBUTES>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="SYN-KIND" LONG-NAME="kind"/>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="SYN-PARAMS" LONG-NAME="params"/>
        <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="SYN-QUOTE" LONG-NAME="quote"/>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="SYN-METHOD" LONG-NAME="method"/>
        <ATTRIBUTE-DEFINITION-BOOLEAN IDENTIFIER="SYN-TBC" LONG-NAME="tbc"/>
      </SPEC-ATTRIBUTES>
    </SPEC-OBJECT-TYPE></SPEC-TYPES>
    <SPEC-OBJECTS><SPEC-OBJECT IDENTIFIER="SYN-REQ-XML-1">
      <TYPE><SPEC-OBJECT-TYPE-REF>SYN-TYPE</SPEC-OBJECT-TYPE-REF></TYPE>
      <VALUES>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="envelope_max_mm"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>SYN-KIND</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;value&quot;: 25}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>SYN-PARAMS</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>SYN-QUOTE</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><div xmlns="http://www.w3.org/1999/xhtml"><p>Maximum envelope dimension is 25 mm.</p></div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="T"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>SYN-METHOD</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-BOOLEAN THE-VALUE="false"><DEFINITION><ATTRIBUTE-DEFINITION-BOOLEAN-REF>SYN-TBC</ATTRIBUTE-DEFINITION-BOOLEAN-REF></DEFINITION></ATTRIBUTE-VALUE-BOOLEAN>
      </VALUES>
    </SPEC-OBJECT></SPEC-OBJECTS>
  </SPECIFICATION-XML></CORE-CONTENT>
</REQ-IF>
