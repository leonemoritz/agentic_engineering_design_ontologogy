<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd">
  <THE-HEADER><REQ-IF-HEADER IDENTIFIER="SYN-HEADER"/></THE-HEADER>
  <CORE-CONTENT><SPECIFICATION-XML>
    <SPEC-TYPES><SPEC-OBJECT-TYPE IDENTIFIER="SYN-TYPE" LONG-NAME="Synthetic requirement">
      <SPEC-ATTRIBUTES>
        <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="SYN-QUOTE" LONG-NAME="quote"/>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="SYN-ATTRIBUTE" LONG-NAME="attribute"/>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="SYN-RELATION" LONG-NAME="relation"/>
        <ATTRIBUTE-DEFINITION-REAL IDENTIFIER="SYN-VALUE" LONG-NAME="value"/>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="SYN-UNIT" LONG-NAME="unit"/>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="SYN-METHOD" LONG-NAME="method"/>
        <ATTRIBUTE-DEFINITION-BOOLEAN IDENTIFIER="SYN-TBC" LONG-NAME="tbc"/>
      </SPEC-ATTRIBUTES>
    </SPEC-OBJECT-TYPE></SPEC-TYPES>
    <SPEC-OBJECTS><SPEC-OBJECT IDENTIFIER="R2">
      <TYPE><SPEC-OBJECT-TYPE-REF>SYN-TYPE</SPEC-OBJECT-TYPE-REF></TYPE>
      <VALUES>
        <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>SYN-QUOTE</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><div xmlns="http://www.w3.org/1999/xhtml"><p>SYS shall have l &lt;= 25 mm.</p></div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="l"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>SYN-ATTRIBUTE</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="le"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>SYN-RELATION</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-REAL THE-VALUE="0.025"><DEFINITION><ATTRIBUTE-DEFINITION-REAL-REF>SYN-VALUE</ATTRIBUTE-DEFINITION-REAL-REF></DEFINITION></ATTRIBUTE-VALUE-REAL>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="m"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>SYN-UNIT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="T"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>SYN-METHOD</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-BOOLEAN THE-VALUE="false"><DEFINITION><ATTRIBUTE-DEFINITION-BOOLEAN-REF>SYN-TBC</ATTRIBUTE-DEFINITION-BOOLEAN-REF></DEFINITION></ATTRIBUTE-VALUE-BOOLEAN>
      </VALUES>
    </SPEC-OBJECT></SPEC-OBJECTS>
  </SPECIFICATION-XML></CORE-CONTENT>
</REQ-IF>
